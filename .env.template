# Odnośniki do sekretów dla 1Password CLI (lekcja 09, poziom 2). Bez wartości — można commitować.
# Uruchomienie: op run --env-file=.env.template -- npm run dev
# Zwykłe wartości przechodzą bez zmian; odnośniki op://Sejf/Pozycja/pole są rozwiązywane
# przy starcie i trafiają tylko do procesu potomnego. Nic nie jest zapisywane na dysku.
# Wymaga sejfu DevMentor-Dev z pozycją Postgres (pole connection-string).

# Baza danych
DATABASE_URL=op://DevMentor-Dev/Postgres/connection-string

# Adres aplikacji
NEXT_PUBLIC_APP_URL=http://localhost:3000
