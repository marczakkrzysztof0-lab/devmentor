{
  "name": "devmentor",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.12"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "setup": "node scripts/setup.mjs",
    "db:migrate": "node scripts/db-migrate.mjs up",
    "db:rollback": "node scripts/db-migrate.mjs down",
    "mentor:invite": "node scripts/mentor-links.mjs invite",
    "mentor:sign-in-link": "node scripts/mentor-links.mjs sign-in-link",
    "storybook": "npm run storybook -w @devmentor/ui",
    "build-storybook": "npm run build-storybook -w @devmentor/ui",
    "test:storybook": "npm run test -w @devmentor/ui",
    "test:storybook:themes": "npm run test:themes -w @devmentor/ui",
    "check:tokens": "npm run check:tokens -w @devmentor/ui",
    "typecheck:ui": "npm run typecheck -w @devmentor/ui"
  },
  "dependencies": {
    "next": "16.4.0",
    "node-pg-migrate": "9.0.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
