{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(./**/*.pem)",
      "Read(./lekcja-09/pulapka/fixtures/private/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.npmrc)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.config/gh",
        "~/.kube",
        "~/.npmrc",
        "~/.pypirc",
        "~/**/.env",
        "~/**/.env.local"
      ]
    },
    "network": {
      "allowedDomains": ["github.com", "api.github.com", "registry.npmjs.org"],
      "deniedDomains": ["169.254.169.254", "metadata.google.internal"]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-tool-use.mjs\"" }
        ]
      }
    ]
  }
}
