{
  "name": "@devmentor/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/index.css",
    "./tokens.css": "./src/styles/tokens.css",
    "./product": "./src/product/index.ts",
    "./text": "./src/lib/text.mjs"
  },
  "scripts": {
    "storybook": "storybook dev -p 6006 --no-open --no-version-updates",
    "build-storybook": "storybook build",
    "test": "vitest run --project=storybook",
    "test:themes": "node scripts/test-themes.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "state-map": "node scripts/state-map.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.58.0",
    "radix-ui": "1.8.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/addon-vitest": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@tailwindcss/vite": "4.3.3",
    "@vitest/browser-playwright": "5.0.5",
    "eslint-plugin-storybook": "10.6.2",
    "geist": "1.8.1",
    "playwright": "1.64.1",
    "remark-gfm": "4.0.1",
    "storybook": "10.6.2",
    "tailwindcss": "4.3.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
